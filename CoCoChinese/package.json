{
  "name": "cocokalo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix nodffmpeg && npm run build --prefix ftssearch && npm run build --prefix frontend",
    "start": "node frontend/.output/server/index.mjs",
    "postinstall": "cd ftssearch && npm install && npm run build && cd ../frontend && npm install",
    "db:init": "node scripts/initDB.js",
    "admin:create": "node frontend/scripts/createAdmin.cjs",
    "serviceinstall": "npm run serviceinstall --prefix frontend",
    "serviceuninstall": "npm run serviceuninstall --prefix frontend"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "dependencies": {
    "which": "^7.0.0"
  }
}
