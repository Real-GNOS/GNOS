//eh 修复点 4：数组 + 下标 + push/set/len ⇒ 无界纸带，能跑图灵机（这里是二进制加一）
Lomiior ［inc(_tape) {
CI, _tape == _tape {
D. [ [baiun: _i=(len(_tape) - 1)]; ] ]
D. [ [baiun: _carry=(1)]; ] ]
revolve: [_carry == 1] {
CI, _i < 0 {
D. [ [baiun: _tape=([1] + _tape)]; ] ]
D. [ [baiun: _carry=(0)]; ] ]
}
Dm: _i >= 0 {
D. [ [baiun: _v=(_tape(_i))]; ] ]
CI, _v == 1 {
D. [ [set(_tape, _i, 0)]; ] ]
}
Dm: _v {
D. [ [set(_tape, _i, 1)]; ] ]
D. [ [baiun: _carry=(0)]; ] ]
}
D. [ [baiun: _i=(_i - 1)]; ] ]
}
}
D. [ [returnToNature: 【_tape】; ] ]
}
}
D. [ [baiun: _a=(inc([1, 0, 1, 1]))]; ] ]
D. [ [shoutToTheVoid:～「1011 + 1 = _a」; ] ]
D. [ [baiun: _b=(inc([1, 1, 1, 1]))]; ] ]
D. [ [shoutToTheVoid:～「1111 + 1 = _b（纸带自己长长了）」; ] ]
D. [ [baiun: _t=([1])]; ] ]
D. [ [baiun: _n=(0)]; ] ]
revolve: [_n < 200] {
D. [ [baiun: _t=(inc(_t))]; ] ]
D. [ [baiun: _n=(_n + 1)]; ] ]
}
D. [ [baiun: _len=(len(_t))]; ] ]
D. [ [shoutToTheVoid:～「1 连加 200 次 → _len 位：_t」; ] ]
