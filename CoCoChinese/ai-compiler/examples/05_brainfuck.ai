Sorry, eh?
//eh 修复点 1-4 合体：Aifolia 里写一个 brainfuck 解释器。
//eh 解释一个图灵完备语言 ⇒ Aifolia 自己也是图灵完备的（下面跑的是 Hello World）
//eh 语法：数组 list()/push/set/len、下标 _xs(i)、字符串按下标取字符 _s(i)、if / else if / else、无界 revolve: 循环
D. [ [baiun: _prog=("++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.")]; ] ]
D. [ [baiun: _tape=(list())]; ] ]
D. [ [baiun: _z=(0)]; ] ]
revolve: [_z < 64] {
D. [ [push(_tape, 0)]; ] ]
D. [ [baiun: _z=(_z + 1)]; ] ]
}
D. [ [baiun: _p=(32)]; ] ]
D. [ [baiun: _pc=(0)]; ] ]
D. [ [baiun: _n=(len(_prog))]; ] ]
D. [ [baiun: _out=(list())]; ] ]
revolve: [_pc < _n] {
D. [ [baiun: _op=(_prog(_pc))]; ] ]
CI, _op == "+" {
D. [ [set(_tape, _p, (_tape(_p) + 1))]; ] ]
}
Dm: _op == "-" {
D. [ [set(_tape, _p, (_tape(_p) - 1))]; ] ]
}
Dm: _op == ">" {
D. [ [baiun: _p=(_p + 1)]; ] ]
}
Dm: _op == "<" {
D. [ [baiun: _p=(_p - 1)]; ] ]
}
Dm: _op == "." {
D. [ [push(_out, _tape(_p))]; ] ]
}
Dm: _op == "[" {
CI, _tape(_p) == 0 {
D. [ [baiun: _d=(1)]; ] ]
revolve: [_d > 0] {
D. [ [baiun: _pc=(_pc + 1)]; ] ]
D. [ [baiun: _c=(_prog(_pc))]; ] ]
CI, _c == "[" {
D. [ [baiun: _d=(_d + 1)]; ] ]
}
Dm: _c == "]" {
D. [ [baiun: _d=(_d - 1)]; ] ]
}
}
}
}
Dm: _op == "]" {
CI, _tape(_p) != 0 {
D. [ [baiun: _d=(1)]; ] ]
revolve: [_d > 0] {
D. [ [baiun: _pc=(_pc - 1)]; ] ]
D. [ [baiun: _c=(_prog(_pc))]; ] ]
CI, _c == "]" {
D. [ [baiun: _d=(_d + 1)]; ] ]
}
Dm: _c == "[" {
D. [ [baiun: _d=(_d - 1)]; ] ]
}
}
}
}
D. [ [baiun: _pc=(_pc + 1)]; ] ]
}
D. [ [shoutToTheVoid:～「BF 输出（ASCII 码）= _out」; ] ]
