//eh 返回值 + 递归：修复点 1（returnToNature 之前在函数里根本不会执行，永远返回 ()）
Lomiior ［fact(_n) {
CI, _n <= 1 {
D. [ [returnToNature: 【1】; ] ]
}
D. [ [returnToNature: 【(_n * fact((_n - 1)))】; ] ]
}
D. [ [baiun: _f=(fact(10))]; ] ]
D. [ [shoutToTheVoid:～「10! = _f」; ] ]
D. [ [baiun: _fib=(fib(20))]; ] ]
D. [ [shoutToTheVoid:～「fib(20) = _fib」; ] ]
Lomiior ［fib(_n) {
CI, _n < 2 {
D. [ [returnToNature: 【_n】; ] ]
}
D. [ [returnToNature: 【(fib((_n - 1)) + fib((_n - 2)))】; ] ]
}
