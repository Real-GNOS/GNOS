{
  "name": "ftssearch",
  "version": "1.0.0",
  "description": "PostgreSQL Full-Text Search engine — built-in cache (in-memory LRU + Redis), request dedup, standalone API server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ftssearch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgresql",
    "full-text-search",
    "fts",
    "search-engine",
    "cache",
    "redis",
    "elasticsearch-alternative"
  ],
  "license": "MIT",
  "dependencies": {
    "pg": "^8.13.0"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
