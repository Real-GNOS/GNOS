[Unit]
Description=Cocokalo Frontend (dev)
After=network.target

[Service]
Type=simple
User=elaina
WorkingDirectory=/home/elaina/Cocokalo/frontend
ExecStart=/home/elaina/Cocokalo/frontend/node_modules/.bin/nuxt dev --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=development
# / 分区（15G）已满，nuxt dev 的 Vite 临时目录（mkdtemp /tmp/nuxt-vite-*）
# 会撞 ENOSPC；把 TMPDIR 指到大分区 /home 上，build 才能跑起来。
Environment=TMPDIR=/home/elaina/tmp

[Install]
WantedBy=multi-user.target
