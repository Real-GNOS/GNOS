{
  "name": "cocokalo-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 3000",
    "serviceinstall": "sudo cp cocokalo.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable cocokalo && sudo systemctl start cocokalo",
    "serviceuninstall": "sudo systemctl stop cocokalo && sudo systemctl disable cocokalo && sudo rm /etc/systemd/system/cocokalo.service && sudo systemctl daemon-reload"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "cropperjs": "^2.1.1",
    "element-plus": "^2.14.3",
    "@popperjs/core": "^2.11.8",
    "ftssearch": "file:../ftssearch",
    "hls.js": "^1.6.16",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodffmpeg": "file:../nodffmpeg",
    "nuxt": "^3.16.0",
    "pg": "^8.22.0",
    "plyr": "^3.8.4",
    "prisma": "^5.22.0",
    "vue": "latest",
    "vue-router": "latest",
    "which": "7.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "pnpm": {
    "overrides": {
      "which@^1.1.1": "7.0.0"
    }
  }
}
