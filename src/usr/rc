#!/bin/sh
# Boot: login prompts on tty1/tty2, then the smoke tests, then the
# Xorg/twm/xeyes session at the end of the script.  Xorg covers the console
# with its own scanout while it runs, so the login prompt lives on the ttys
# until the server is shut down again.
mkdir -p /var/log /tmp/run

/sbin/getty tty1 &
/sbin/getty tty2 &

# VT switch residue check: switch to an empty console (tty3).
#/usr/bin/chvt 3

# NEP1 (NeoRunst): the kernel execve path loads .nep images directly.
#/bin/nep1 /root/app.nep >/tmp/nep.out 2>&1 &
#/bin/dbgcat.elf /tmp/nep.out

# pty subsystem self-test (line discipline, signals, ioctls).
#/bin/pty_test >/tmp/pty.out 2>&1
#/bin/dbgcat.elf /tmp/pty.out

# audio: decode the MP3 to raw PCM and feed /dev/dsp (AC97 48k stereo).
# The player must be allowed to tcsetattr the console even though getty's
# session owns it: ignoring SIGTTOU here is inherited by every child.
trap "" TTOU

# --- audio: OSS sanity, decode, then ALSA playback ---
/usr/bin/dd if=/dev/urandom of=/dev/dsp bs=4096 count=40 > /tmp/audio.out 2>&1
echo "noise_exit=$?" >> /tmp/audio.out
/usr/bin/mpg123 -w /tmp/mao.wav /root/MAO.mp3 > /tmp/audio.out 2>&1
echo "decode_exit=$?" >> /tmp/audio.out
/usr/bin/ls -l /tmp/mao.wav >> /tmp/audio.out 2>&1
/usr/bin/aplay /tmp/mao.wav > /tmp/aplay.out 2>&1
echo "play_exit=$?" >> /tmp/audio.out
/bin/dbgcat.elf /tmp/audio.out
/bin/dbgcat.elf /tmp/aplay.out

# klog + cpuid syscall tests
/bin/klogtest > /tmp/klog.out 2>&1
/bin/dbgcat.elf /tmp/klog.out

# --- OpenRC (Uinxed recipe: sysinit/boot/default runlevels) ---
mkdir -p /run/openrc /run/lock /lib/rc/cache
/sbin/openrc sysinit > /tmp/openrc-sysinit.out 2>&1
echo "openrc_sysinit_exit=$?" >> /tmp/openrc-sysinit.out
/sbin/openrc boot > /tmp/openrc-boot.out 2>&1
echo "openrc_boot_exit=$?" >> /tmp/openrc-boot.out
/sbin/openrc default > /tmp/openrc-default.out 2>&1
echo "openrc_default_exit=$?" >> /tmp/openrc-default.out
/bin/dbgcat.elf /tmp/openrc-sysinit.out
/bin/dbgcat.elf /tmp/openrc-boot.out
/bin/dbgcat.elf /tmp/openrc-default.out

# syscall batch-1 verification
/bin/syntest > /tmp/syn.out 2>&1
/bin/dbgcat.elf /tmp/syn.out

/bin/syn3 > /tmp/syn3.out 2>&1
/bin/dbgcat.elf /tmp/syn3.out

# interrupt accounting check
/usr/bin/cat /proc/interrupts > /tmp/intr.out
sleep 1
/usr/bin/cat /proc/interrupts >> /tmp/intr.out
/bin/dbgcat.elf /tmp/intr.out

/usr/bin/cat /proc/slabinfo > /tmp/slab.out 2>&1
/bin/dbgcat.elf /tmp/slab.out

# network batch-3 checks: fragmented loopback ping + proc tables
/bin/nettest > /tmp/net.out 2>&1
/bin/dbgcat.elf /tmp/net.out
/usr/bin/cat /proc/net/arp > /tmp/arp.out 2>&1
/usr/bin/cat /proc/net/udp > /tmp/udp.out 2>&1
/bin/dbgcat.elf /tmp/arp.out
/bin/dbgcat.elf /tmp/udp.out

# FAT32 mount check: attached as -device ide-hd (NOT if=ide,index=1 -- that
# collides with the CD-ROM and the BIOS then finds no bootable disk).
mkdir -p /mnt/fat
/bin/mount -t vfat /dev/sda /mnt/fat > /tmp/fat.out 2>&1
echo "mount_exit=$?" >> /tmp/fat.out
/usr/bin/ls -l /mnt/fat >> /tmp/fat.out 2>&1
/usr/bin/cat /mnt/fat/HELLO.TXT >> /tmp/fat.out 2>&1
/bin/dbgcat.elf /tmp/fat.out

# vcs device check (batch 4): read the screen as a file
/usr/bin/head -c 80 /dev/vcs > /tmp/vcs.out 2>&1
echo "vcs_exit=$?" >> /tmp/vcs.out
/bin/dbgcat.elf /tmp/vcs.out

# devtmpfs: /dev backed by the live registry
/bin/mount -t devtmpfs none /dev > /tmp/dt.out 2>&1
echo "devtmpfs_exit=$?" >> /tmp/dt.out
/usr/bin/ls /dev >> /tmp/dt.out 2>&1
/bin/dbgcat.elf /tmp/dt.out

# ISO9660: mount the boot CD via ATAPI
mkdir -p /mnt/cdrom
/bin/mount -t iso9660 /dev/sr0 /mnt/cdrom > /tmp/cd.out 2>&1
echo "cd_exit=$?" >> /tmp/cd.out
/usr/bin/ls /mnt/cdrom >> /tmp/cd.out 2>&1
/bin/dbgcat.elf /tmp/cd.out

# copy-on-write: the kernel's fork() now shares pages instead of copying
# them, and everything above has been running on that.  This checks it:
# writes separate the page, reads do not, through fork, exec and mprotect.
/bin/cowtest.elf >/tmp/cow.out 2>&1
echo "COW_EXIT=$?" >>/tmp/cow.out
/bin/dbgcat.elf /tmp/cow.out

# apk over https: the image's root filesystem IS Alpine, so /sbin/apk is the
# real thing -- with the CA bundle, the signing keys and an https repository
# line already in place.  DNS rides the slirp resolver at 10.0.2.3.
/sbin/apk --version >/tmp/apk.out 2>&1
/sbin/apk update >>/tmp/apk.out 2>&1
echo "UPDATE_EXIT=$?" >>/tmp/apk.out
/sbin/apk fetch -o /tmp/apkdl lua-alt-getopt >>/tmp/apk.out 2>&1
echo "FETCH_EXIT=$?" >>/tmp/apk.out
/bin/dbgcat.elf /tmp/apk.out


# clang smoke test: the driver spawns cc1/ld via posix_spawn (CLONE_VFORK).
/usr/bin/clang /root/test.c -o /tmp/test >/tmp/clang.out 2>&1
echo "CC_EXIT=$?" >>/tmp/clang.out
/tmp/test >>/tmp/clang.out 2>&1
echo "RUN_EXIT=$?" >>/tmp/clang.out
/bin/dbgcat.elf /tmp/clang.out

/sbin/wiggle

# --- Xorg/twm/xeyes desktop session -------------------------------------------
# Last, because Xorg takes over the display: everything above has already
# written its results to the debugcon log by the time the screen is covered.
# xsetroot paints the root window first -- a client-free Xorg screen is just
# the black root window (-br), indistinguishable from a dead pipeline -- and
# sets the left_ptr sprite so pointer motion is visible before any client
# window is under it.  twm comes up before the clients so they are managed
# (title bars, move, resize).
#/usr/libexec/Xorg -config /etc/X11/xorg.conf -noreset -logverbose 6 \
#    -logfile /var/log/Xorg.0.log :0 >/tmp/xorg.out 2>&1 &
#sleep 15
#DISPLAY=:0 /usr/bin/xsetroot -solid gray40 -cursor_name left_ptr >/tmp/xsetroot.out 2>&1
#DISPLAY=:0 /usr/bin/twm >/tmp/twm.out 2>&1 &
#DISPLAY=:0 /usr/bin/xeyes -geometry +100+100 >/tmp/xeyes.out 2>&1 &
#DISPLAY=:0 /usr/bin/xterm -geometry 80x25 -background white \
#    -foreground black >/tmp/xterm.out 2>&1 &
# Push the server log into the debugcon log (grep-able on the host).
#/bin/dbgcat.elf /var/log/Xorg.0.log
sleep 8
{
    echo "=== XORG STDOUT ==="
    cat /tmp/xorg.out
    echo "=== XSETROOT STDOUT ==="
    cat /tmp/xsetroot.out
    echo "=== TWM STDOUT ==="
    cat /tmp/twm.out
    echo "=== XEYES STDOUT ==="
    cat /tmp/xeyes.out
    echo "=== XTERM STDOUT ==="
    cat /tmp/xterm.out
    echo "=== XORG LOG (tail) ==="
    tail -40 /var/log/Xorg.0.log
    echo "=== END ==="
} > /dev/tty2 2>&1
