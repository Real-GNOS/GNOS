# /etc/os-release — what AEOS tells the world it is.
#
# fastfetch (and every other os-release consumer) keys its distro detection
# off this file: ID is matched first against the logo table, NAME second,
# and PRETTY_NAME is what goes in the OS line.  AEOS has a matching entry in
# fastfetch's logo builtins (src/logo/ascii/g/aeos.txt in the fastfetch
# tree), so detection and the system icon resolve to the same name.
NAME=AEOS
ID=aeos
ID_LIKE=linux
PRETTY_NAME="AEOS"
VERSION="0.1"
VERSION_ID="0.1"
HOME_URL="https://example.invalid/aeos"
SUPPORT_URL="https://example.invalid/aeos"
BUILD_ID=rolling
