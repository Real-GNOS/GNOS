#!/bin/sh
# xfce-desktop -- bring up the Xfce desktop on Xorg :0 through xinit. (GPLv2)
#
# Spawned by /etc/inittab with ::respawn:, so a crashed session comes back
# the way a display manager would.  All the environment work Xfce needs
# (runtime dirs, dbus, machine-id, the root-window paint) lives in
# /sbin/start-xfce; this wrapper only owns the X server lifecycle -- and it
# hands even that to xinit(1).
#
# xinit is the one piece of X11 that knows what "the server is up" means: it
# starts the server, waits until it actually accepts a connection, runs the
# client with DISPLAY and XAUTHORITY set, and shuts the server down when the
# client exits.  This script used to do that by hand -- background Xorg,
# sleep a while, hope -- which is where every "the session ran before the
# server was ready" failure in the debug log came from.

export HOME=/root
export PATH=/usr/bin:/bin:/sbin:/usr/sbin
export DISPLAY=:0

# xinit writes its cookie to $HOME/.Xauthority (or $XAUTHORITY when it is
# set), so HOME has to be exported and writable before xinit runs; the
# client inherits the XAUTHORITY xinit then exports.
mkdir -p /var/log /tmp/run

# --- the session ---------------------------------------------------------
# Argument order is xinit's: the client and its options, then `--`, then the
# server, the display, and the server's options.  Both program names start
# with a slash, which is what tells xinit they are programs rather than
# extra arguments to append to the default startup lines.
#
# Xorg takes over vt1 (the visible console), so boot lands directly on the
# desktop; the agetty that still respawns on tty1 redraws the login prompt if
# the server ever exits -- the no-display-manager rescue path.  xinit's stdout
# carries Xorg's, which is the only place a server that dies before it has
# opened its log says anything at all.
/usr/bin/xinit /sbin/start-xfce -- \
    /usr/libexec/Xorg :0 vt1 -config /etc/X11/xorg.conf -noreset \
    -logfile /var/log/Xorg.0.log >/tmp/xinit.out 2>&1

# --- post-mortem ---------------------------------------------------------
# xinit returns once the client has exited, whether that was a clean logout
# or the session losing its X connection after a server fatal.  The log on
# disk is final by then, so push it to the debugcon where the host can grep
# it; the session's own output is in /tmp/xfce.out (see start-xfce).
/bin/dbgcat.elf /var/log/Xorg.0.log
/bin/dbgcat.elf /tmp/xinit.out
/bin/dbgcat.elf /tmp/xfce.out
/bin/dbgcat.elf /tmp/xsetroot.out 2>/dev/null

exit 0
