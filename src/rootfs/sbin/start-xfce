#!/bin/sh
# start-xfce — bring up an XFCE session on the running X server. (GPLv2)
#
# Usage: (from a shell with DISPLAY set, Xorg already running)
#   /sbin/start-xfce
#
# XFCE needs a session D-Bus before xfce4-session will talk to anyone.
X11RUN=/tmp/run
DBUS_DAEMON=/usr/bin/dbus-daemon

if [ -z "$DISPLAY" ]; then
    echo "start-xfce: DISPLAY is not set"
    exit 1
fi

# --- accessibility -------------------------------------------------------
# Every GTK/Xfce component loads at-spi2-atk's atk-bridge as a GTK module at
# gtk_init() time, in the main thread.  atk-bridge blocks there in
# g_bus_get_sync() waiting for the org.a11y.Bus name to appear on the session
# bus; on this kernel at-spi-bus-launcher dies with SIGSEGV, so activation
# never completes and the app never gets as far as creating a window (the
# screen stays the empty xsetroot root window).  NO_AT_BRIDGE=1 makes
# atk-bridge skip the bus entirely; clearing GTK_MODULES stops any other
# module from pulling the same bridge back in.
export NO_AT_BRIDGE=1
export GTK_MODULES=""
export QT_ACCESSIBILITY=0

# --- GLX / drisw ----------------------------------------------------------
# The X server provides the software GLX provider (DRISWRAST / swrast); there
# is no hardware DRI driver and glamor (hence the kopper / drisw-over-DRI3
# direct path) is unavailable on this stack.  Forcing indirect GLX routes
# every client's GLX call through that server-side software provider, which
# is exactly the drisw software-GLX path we want and avoids the dead direct
# path.  libGL picks the loader on its own, so leave the override empty.
export LIBGL_ALWAYS_INDIRECT=1
export MESA_LOADER_DRIVER_OVERRIDE=""

# --- GSettings -----------------------------------------------------------
# The initrd ships libxfconfgsettingsbackend.so in usr/lib/gio/modules, so
# every g_settings_new() (GTK3 does several inside gtk_init()) becomes a
# synchronous D-Bus round-trip to xfconfd.  A backend that never answers
# wedges gtk_init() before any window is mapped -- xeyes (plain Xlib) still
# draws, all GTK/Xfce clients stay an empty root window.  Use the in-memory
# backend for the session so those lookups are local.
export GSETTINGS_BACKEND=memory
export GIO_USE_VFS=local

# --- the environment the rest of the session assumes ---------------------
# startxfce (the post-login launcher) sets all of these.  xfconfd, the panel
# and xfce4-session write under XDG_CONFIG_HOME/XDG_CACHE_HOME on first run,
# and a missing parent turns those writes into silent failures.  fontconfig
# and libxkbcommon also need their data paths pinned to what the initrd
# carries.  Without this the inittab path behaves differently from startxfce.
export HOME=/root
export XDG_RUNTIME_DIR=/tmp/run
export XDG_CONFIG_HOME=/root/.config
export XDG_DATA_HOME=/root/.local/share
export XDG_CACHE_HOME=/root/.cache
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null

# dbus-uuidgen segfaults on this kernel; a fixed 32-hex-char id is exactly
# as good for a session bus.
mkdir -p /var/lib/dbus
if [ ! -f /var/lib/dbus/machine-id ]; then
    echo 00000000000000000000000000000000 > /var/lib/dbus/machine-id
fi

mkdir -p $X11RUN

# Root window paint, before any client: a client-free X screen is just the
# black root window (-br), indistinguishable from a dead pipeline, and the
# left_ptr sprite makes pointer motion visible before any client window is
# under it.  Bounded: Xlib spins forever without re-issuing a syscall when
# the connection-setup reply is late (EAGAIN), so an unbounded xsetroot
# dead-locks the launch.  5 s is plenty for a root-window paint.
/usr/bin/timeout 5 /usr/bin/xsetroot -solid gray40 -cursor_name left_ptr \
    >/tmp/xsetroot.out 2>&1

# Session bus: the address lands in a file and in the environment of
# everything we start afterwards.
if [ ! -f $X11RUN/session-bus ]; then
    $DBUS_DAEMON --session --fork \
        --print-address > $X11RUN/session-bus 2>/dev/null
fi
DBUS_SESSION_BUS_ADDRESS=$(cat $X11RUN/session-bus)
export DBUS_SESSION_BUS_ADDRESS

# xfconfd pre-launch: xfce4-session blocks on Xfconf the moment it starts,
# which normally goes through dbus-daemon's automatic service activation.
# That spawn path (fork + config-over-pipe + exec) stalls in our kernel,
# so start the daemon directly -- it registers org.xfce.Xfconf on the bus
# and xfce4-session talks to it without ever asking dbus to spawn.  A
# second instance would simply fail to own the name and exit.
/usr/lib/xfce4/xfconf/xfconfd >/dev/null 2>&1 &
sleep 1

# XFCE itself.  startxfce4 re-runs Xinit looking for an X server; with the
# server already up we run the session manager directly.  xfce4-session
# brings up xfwm4/panel/xfdesktop from xfconf AND processes the XDG
# autostart directories (/etc/xdg/autostart, ~/.config/autostart) -- the
# manual component launch this script used to do bypassed that machinery,
# so nothing in autostart ever ran.
# Probe the fork+pipe handshake every spawn path relies on, before the
# session manager exercises it for real.  The dumper runs in the background
# so the markers reach the debugcon even if the probe wedges.
( sleep 20; /bin/dbgcat.elf /tmp/spawn.out ) &
/usr/bin/spawntest >/tmp/spawn.out 2>&1 &
sleep 1
# Diagnostics first: a session manager that dies at startup must say why
# on the debugcon, or every respawn cycle fails silently.  The session
# manager may also HANG without ever exiting (each respawn cycle then
# fails silently forever), so dump its output once, 25 seconds in, even
# while it is still running.
/usr/bin/xfce4-session >/tmp/xfce.out 2>&1 &
SESS_PID=$!
( sleep 25; /bin/dbgcat.elf /tmp/xfce.out ) &

# The session manager spawns its components through g_spawn, whose
# fork+error-pipe handshake stalls in our kernel the same way dbus's
# spawn path does -- xfwm4/xfdesktop/panel never appear and the screen
# stays an empty root window.  Launch the desktop pieces directly; the
# session manager keeps running for session/dbus housekeeping.
sleep 3
/usr/bin/xfsettingsd >/tmp/xfsettingsd.out 2>&1 &
# The compositor uses the working indirect GLX (DRISWRAST) path above; it is
# left enabled so window buffering/compositing is available.
/usr/bin/xfwm4 >/tmp/xfwm4.out 2>&1 &
/usr/bin/xfdesktop >/tmp/xfdesktop.out 2>&1 &
/usr/bin/xfce4-panel >/tmp/xfce4-panel.out 2>&1 &

# XDG autostart entry (xfce4-terminal) until xfce4-session's autostart
# machinery runs on its own.
sleep 3
/usr/bin/xfce4-terminal >/tmp/xfce4-terminal.out 2>&1 &

# DIAGNOSTIC: capture what each component actually said, so a missing
# window has a reason in the log instead of silence.  Also snapshot the
# live process table and the Xorg log, so we can tell a crashed component
# (gone from /proc) from a hung one (present but silent).
( sleep 30;
  for f in xfsettingsd xfwm4 xfdesktop xfce4-panel xfce4-terminal; do
      /bin/dbgcat.elf /tmp/$f.out
  done
  /bin/dbgcat.elf /var/log/Xorg.0.log
  echo "=== live processes ===" > /tmp/ps.out
  for p in /proc/[0-9]*; do
      cmd=$(tr '\0' ' ' < $p/cmdline 2>/dev/null)
      [ -n "$cmd" ] && echo "$(basename $p) $cmd" >> /tmp/ps.out
  done
  /bin/dbgcat.elf /tmp/ps.out
) &

wait $SESS_PID
/bin/dbgcat.elf /tmp/xfce.out
