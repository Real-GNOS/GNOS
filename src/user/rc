#!/bin/sh
# Boot: login prompts on tty1/tty2, then the smoke tests.
# The Xorg/twm/xeyes block is kept (commented) for interactive runs;
# the headless boot exercises apk over the slirp network.
mkdir -p /var/log /tmp/run

/sbin/getty tty1 &
/sbin/getty tty2 &

# apk over http: static apk + slirp (kernel TCP, DNS via 10.0.2.3).
/sbin/apk.static --version >/tmp/apk.out 2>&1
/sbin/apk.static update >>/tmp/apk.out 2>&1
/bin/dbgcat.elf /tmp/apk.out


# clang smoke test: the driver spawns cc1/ld via posix_spawn (CLONE_VFORK).
/usr/bin/clang /root/test.c -o /tmp/test >/tmp/clang.out 2>&1
echo "CC_EXIT=$?" >>/tmp/clang.out
/tmp/test >>/tmp/clang.out 2>&1
echo "RUN_EXIT=$?" >>/tmp/clang.out
/bin/dbgcat.elf /tmp/clang.out

