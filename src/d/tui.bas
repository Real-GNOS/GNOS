100 REM === hudos TUI desktop (BASIC) - 3D buttons ===
110 DIM F(64)
120 W=0 : M=0 : N$="" : K=0 : S=0 : T=0 : I=0 : L=0
130 SCR G,H
140 C=G/8 : R=H/16
150 P=G/2 : Q=H/2
160 PRINT "BASIC TUI start"
1000 REM main loop
1010 GOSUB 2000
1020 MOUSE P,Q,B,D
1030 KEY V,E
1040 IF V<>0 THEN GOSUB 5000
1050 IF D=1 THEN GOSUB 6000
1060 SLEEP 20
1070 GOTO 1000
2000 REM draw frame
2010 CLS 1
2020 RECT 0,0,G,16,2
2030 TEXT 8,0,"hudos",15,2
2040 IF M=1 THEN GOSUB 2100
2050 BOX 4,4,16,3,"Notepad",0,15,9
2060 BOX 4,9,16,3,"About",0,15,9
2070 IF W=1 THEN GOSUB 3000
2080 IF W=2 THEN GOSUB 4000
2090 RETURN
2100 REM dropdown
2110 RECT 8,16,96,48,2
2120 TEXT 16,16,"about hudos",15,2
2130 RETURN
3000 REM About window
3010 U=40 : V=9 : IF U>C-2 THEN U=C-2 : IF V>R-2 THEN V=R-2
3020 X=(C-U)/2 : Y=(R-V)/2
3030 BOX X,Y,U,V,"About hudos",0,15,9
3040 TEXT (X*8+16),(Y*16+32),"hudos-server 1.0beta",0,9
3050 A=(X+U-8)*8 : E=(Y+V-4)*16
3060 IF B=1 AND P>=A AND P<A+48 AND Q>=E AND Q<E+48 THEN W=0
3070 RETURN
4000 REM Notepad window
4010 U=60 : V=22 : IF U>C-2 THEN U=C-2 : IF V>R-2 THEN V=R-2
4020 X=(C-U)/2 : Y=(R-V)/2
4030 BOX X,Y,U,V,"Notepad",0,15,9
4040 IF L=1 THEN GOSUB 4500 ELSE GOSUB 4600
4050 A=(X+2)*8 : E=(Y+V-4)*16 : O=0
4060 IF B=1 AND P>=A AND P<A+64 AND Q>=E AND Q<E+48 THEN O=1
4070 BTN A,E,64,48,"Save",1,O
4080 A=(X+10)*8 : E=(Y+V-4)*16 : O=0
4090 IF B=1 AND P>=A AND P<A+64 AND Q>=E AND Q<E+48 THEN O=1
4100 BTN A,E,64,48,"Open",2,O
4110 A=(X+U-8)*8 : E=(Y+V-4)*16 : O=0
4120 IF B=1 AND P>=A AND P<A+48 AND Q>=E AND Q<E+48 THEN O=1
4130 BTN A,E,48,48,"OK",0,O
4140 IF T=1 OR T=2 THEN GOSUB 4700
4150 RETURN
4500 REM file list
4510 TEXT (X*8+16),((Y+2)*16),"Open file:",0,9
4520 A=(V-9)/2 : IF A<1 THEN A=1
4530 J=0 : IF K>A THEN J=S-A/2 : IF J<0 THEN J=0 : IF J>K-A THEN J=K-A
4540 FOR Z=0 TO A-1
4550   E=J+Z : IF E>=K THEN GOTO 4590
4560   O=(Y+4)+Z*2
4570   IF E=S THEN RECT (X*8+16),(O*16),(U-4)*8,32,2
4580   T$=STR$(F(E)) : TEXT (X*8+32),(O*16),T$,0,9
4590 NEXT Z
4600 TEXT (X*8+16),((Y+V-4)*16),"Up/Dn select Enter open Esc",0,9
4610 RETURN
4600 REM note content
4610 J=X+2 : O=Y+2 : A=U-5
4620 FOR Z=0 TO LEN(N$)-1
4630   C$=MID$(N$,Z+1,1)
4640   IF ASC(C$)=10 THEN J=X+2 : O=O+1 : IF O>Y+V-6 THEN GOTO 4680
4650   IF J>X+2+A THEN J=X+2 : O=O+1 : IF O>Y+V-6 THEN GOTO 4680
4660   TEXT (J*8),(O*16),C$,0,9
4670   J=J+1 : IF J>X+2+A THEN J=X+2 : O=O+1 : IF O>Y+V-6 THEN GOTO 4680
4680 NEXT Z
4690 RETURN
4700 REM status line
4710 T$="" : IF T=1 THEN T$="Saved " : IF T=2 THEN T$="Opened "
4720 T$=T$+STR$(I)
4730 TEXT (X*8+16),((Y+V-5)*16),T$,0,9
4740 RETURN
5000 REM key handler
5010 IF W=0 THEN IF V=27 OR V=113 OR V=81 THEN END
5020 IF W=2 AND L=1 THEN GOSUB 5200
5030 IF W=1 OR W=2 THEN GOSUB 5300
5040 RETURN
5200 REM list navigation
5210 IF E=1 THEN IF S>0 THEN S=S-1
5220 IF E=2 THEN IF S<K-1 THEN S=S+1
5230 IF V=13 THEN GOSUB 5400 : L=0
5240 IF E=23 THEN L=0
5250 RETURN
5300 REM window key (esc / typing)
5310 IF E=23 THEN GOSUB 5700
5320 IF W=2 THEN GOSUB 5500
5330 RETURN
5400 REM open selected
5410 IF S<0 OR S>=K THEN RETURN
5420 LOAD STR$(F(S)),N$,A
5430 IF A>=0 THEN T=2 : I=F(S) : L=0
5440 RETURN
5500 REM type into note
5510 IF V=13 THEN N$=N$+CHR$(10)
5520 IF V=8 THEN GOSUB 5600
5530 IF V=32 THEN N$=N$+CHR$(32)
5540 IF V>=33 AND V<=126 THEN N$=N$+CHR$(V)
5550 RETURN
5600 REM backspace
5610 A=LEN(N$) : IF A=0 THEN RETURN
5620 N$=MID$(N$,1,A-1)
5630 RETURN
5700 REM esc close
5710 IF W=2 THEN N$=""
5720 W=0
5730 RETURN
6000 REM click handler
6010 IF W=0 THEN GOSUB 6100
6020 IF W=1 THEN GOSUB 6200
6030 IF W=2 THEN GOSUB 6300
6040 RETURN
6100 REM desktop click
6110 IF M=1 THEN GOSUB 6115 : RETURN
6115 IF P>=8 AND P<104 AND Q>=16 AND Q<64 THEN W=1 : M=0 : RETURN
6116 M=0 : RETURN
6120 IF P>=8 AND P<104 AND Q>=0 AND Q<16 THEN M=1 : RETURN
6130 IF P>=32 AND P<160 AND Q>=64 AND Q<112 THEN W=2 : N$="" : RETURN
6140 IF P>=32 AND P<160 AND Q>=144 AND Q<192 THEN W=1 : RETURN
6150 RETURN
6200 REM about click (OK)
6210 U=40 : V=9 : IF U>C-2 THEN U=C-2 : IF V>R-2 THEN V=R-2
6220 X=(C-U)/2 : Y=(R-V)/2
6230 A=(X+U-8)*8 : E=(Y+V-4)*16
6240 IF P>=A AND P<A+48 AND Q>=E AND Q<E+48 THEN W=0
6250 RETURN
6300 REM notepad click
6310 U=60 : V=22 : IF U>C-2 THEN U=C-2 : IF V>R-2 THEN V=R-2
6320 X=(C-U)/2 : Y=(R-V)/2
6330 A=(X+2)*8 : E=(Y+V-4)*16
6340 IF P>=A AND P<A+64 AND Q>=E AND Q<E+48 THEN GOSUB 6400 : RETURN
6350 A=(X+10)*8 : E=(Y+V-4)*16
6360 IF P>=A AND P<A+64 AND Q>=E AND Q<E+48 THEN GOSUB 6500 : RETURN
6370 A=(X+U-8)*8 : E=(Y+V-4)*16
6380 IF P>=A AND P<A+48 AND Q>=E AND Q<E+48 THEN W=0 : N$="" : RETURN
6390 IF L=1 THEN GOSUB 6600
6400 RETURN
6400 REM save
6410 A=1 : N=0
6420 FOR A=1 TO 200
6430   EXISTS STR$(A),E
6440   IF E=0 THEN N=A : A=200
6450 NEXT A
6460 IF N=0 THEN N=1
6470 SAVE STR$(N),N$,J
6480 IF J=0 THEN T=1 : I=N
6490 RETURN
6500 REM open
6510 IF L=1 THEN L=0 : RETURN
6520 K=0
6530 FOR A=1 TO 200
6540   EXISTS STR$(A),E
6550   IF E=1 THEN F(K)=A : K=K+1
6560 NEXT A
6570 IF K>0 THEN S=K-1
6580 L=1
6590 RETURN
6600 REM list click
6610 J=X+2 : E=Y+2
6620 A=(V-9)/2 : IF A<1 THEN A=1
6630 O=0 : IF K>A THEN O=S-A/2 : IF O<0 THEN O=0 : IF O>K-A THEN O=K-A
6640 Z=(Q/16-(Y+4))/2
6650 E=O+Z
6660 IF E>=0 AND E<K THEN S=E : GOSUB 5400 : L=0
6670 RETURN
